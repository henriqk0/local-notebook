/* pynotebook styles - theme-agnostic base */
Screen {
    background: $background;
    color: $text;
}

#sources-pane {
    width: 30%;
    border-right: solid $accent;
    padding: 0 1;
}

#sources {
    height: 1fr;
}

#chat-pane {
    width: 70%;
    padding: 0 1;
}

#chat-log {
    height: 1fr;
    border: solid $accent;
    padding: 0 1;
}

#chat-log Markdown {
    margin-bottom: 1;
}

#chat-input {
    height: 5;
    border: solid $accent;
}

#chat-status {
    height: 1;
    color: $text-muted;
}

#form, #confirm, #path-input, #source-preview {
    width: 60%;
    height: auto;
    padding: 1 2;
    background: $surface;
    border: thick $accent;
    align: center middle;
}

#model-picker {
    width: 80%;
    height: 80%;
    padding: 1 2;
    background: $surface;
    border: thick $accent;
    align: center middle;
}

#model-table {
    height: 1fr;
}
